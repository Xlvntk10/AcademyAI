# Examples only. Set environment variables in PowerShell or your hosting secrets.
# The application does not automatically load this file.
ACADEMY_AUTH_MODE=local
# For real Supabase email OTP, switch mode to supabase and provide all four values.
ACADEMY_PUBLIC_ORIGIN=http://127.0.0.1:4173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Absolute private directory on persistent storage, outside OneDrive and web roots.
# Windows example: C:/Users/user/AppData/Local/AcademyAI/accounts
ACADEMY_ACCOUNTS_DIR=
