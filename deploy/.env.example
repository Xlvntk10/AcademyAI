# Backend only. Never use a VITE_ prefix for these values.
ACADEMY_ENV=production
ACADEMY_AUTH_MODE=supabase
ACADEMY_PUBLIC_ORIGIN=https://YOUR-APP.onrender.com
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE
# Supabase IPv4 session pooler, restricted runtime role, TLS.
DATABASE_URL=postgresql+psycopg://academy_runtime.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
ACADEMY_SERVE_FRONTEND=1
# Keep this ADMIN credential on your maintenance machine only.
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_ADMIN_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
